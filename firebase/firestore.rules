rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && role in userDoc().roles;
    }

    function isPrivileged() {
      return hasRole('admin') || hasRole('coordinator') || hasRole('teacher');
    }

    // USERS
    match /users/{uid} {
      allow read:   if isSignedIn();
      allow create: if hasRole('admin') || hasRole('coordinator');
      allow update: if hasRole('admin') || hasRole('coordinator') ||
                       (request.auth.uid == uid && onlyUpdatingOwnFields());
      allow delete: if hasRole('admin');
    }

    function onlyUpdatingOwnFields() {
      return !('roles' in request.resource.data.diff(resource.data).affectedKeys());
    }

    // GROUPS
    match /groups/{groupId} {
      allow read:  if isSignedIn();
      allow write: if hasRole('admin') || hasRole('coordinator');
    }

    // EVENTS
    match /events/{eventId} {
      allow read:   if isSignedIn();
      allow create: if hasRole('admin') || hasRole('coordinator');
      allow update: if hasRole('admin') || hasRole('coordinator') ||
                       (hasRole('teacher') && isTrainerOfEvent(eventId)) ||
                       (hasRole('teacher') && onlyTrainerSafeFields());
      allow delete: if hasRole('admin') || hasRole('coordinator');
    }

    function isTrainerOfEvent(eventId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/events/$(eventId)).data.trainers;
    }

    function onlyTrainerSafeFields() {
      // Erlaubte Felder die ein Trainer auf einem Event aktualisieren darf
      let allowed = [
        'status', 'cancellationReason', 'skipReason',
        'trainerLateMinutes', 'trainerLateNotes',
        'trainerBroadcast', 'trainers', 'trainerCancellations',
        'substitutionStatus', 'substitutionTrainerId',
        'updatedAt'
      ];
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(allowed);
    }

    // ATTENDANCE
    match /eventAttendance/{docId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isPrivileged() ||
        request.auth.uid == resource.data.userId
      );
      allow delete: if isPrivileged() ||
                       request.auth.uid == resource.data.userId;
    }

    // TRAINER ATTENDANCE (Verspätung, Abmeldung des Betreuers)
    match /trainerAttendance/{docId} {
      allow read:   if isSignedIn();
      allow create: if hasRole('teacher') || isPrivileged();
      allow update: if hasRole('teacher') || isPrivileged();
      allow delete: if isPrivileged();
    }

    // SUBSTITUTION REQUESTS
    // Collection-Name: substitution_requests (mit Unterstrich)
    match /substitution_requests/{docId} {
      // Jeder eingeloggte privilegierte Nutzer darf lesen
      allow read: if isPrivileged();
      // Trainer dürfen neue Anfragen erstellen
      allow create: if hasRole('teacher') || isPrivileged();
      // Update erlaubt für:
      //   - Koordinatoren/Admins (voller Zugriff)
      //   - Den anfragenden Trainer (z.B. Anfrage stornieren)
      //   - Den Zieltrainer (z.B. annehmen/ablehnen)
      //   - Jeden Trainer für Auto-Cancel-Flag (autoCancelNotified)
      //     → wird beim Lazy-Check von beliebigem Dashboard-Opener gesetzt
      allow update: if isPrivileged() ||
                       request.auth.uid == resource.data.requesterId ||
                       request.auth.uid == resource.data.targetTrainerId ||
                       (hasRole('teacher') && onlyAutoCancelNotifiedField());
      allow delete: if isPrivileged();
    }

    // Nur das autoCancelNotified-Flag darf von jedem Teacher gesetzt werden
    function onlyAutoCancelNotifiedField() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['autoCancelNotified', 'status', 'resolution', 'resolvedAt']);
    }

    // SETTINGS
    match /settings/{docId} {
      allow read:  if isSignedIn();
      allow write: if (docId == 'global' && (hasRole('admin') || hasRole('coordinator'))) ||
                      hasRole('admin');
    }

    // SYSTEM MESSAGES
    // Collection-Name: system_messages (mit Unterstrich)
    match /system_messages/{msgId} {
      // Jeder eingeloggte Nutzer darf eigene Nachrichten lesen
      allow read: if isSignedIn() && (
        isPrivileged() ||
        request.auth.uid == resource.data.recipientId
      );
      // Erstellen: privilegierte Nutzer (Koordinatoren, Trainer für Auto-Cancel)
      allow create: if isPrivileged();
      // Update (z.B. als gelesen markieren): Empfänger oder Privilegierte
      allow update: if isPrivileged() ||
                       request.auth.uid == resource.data.recipientId;
      allow delete: if isPrivileged();
    }

    // LEGACY: systemMessages (alter Collection-Name, falls noch in Benutzung)
    match /systemMessages/{msgId} {
      allow read:   if isSignedIn();
      allow create: if isPrivileged();
      allow update: if isPrivileged() ||
                       request.auth.uid == resource.data.recipientId;
      allow delete: if isPrivileged();
    }
  }
}
