rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && role in userDoc().roles;
    }

    function isPrivileged() {
      return hasRole('admin') || hasRole('coordinator') || hasRole('teacher');
    }

    // USERS
    match /users/{uid} {
      allow read: if isPrivileged() || request.auth.uid == uid;
      allow create: if hasRole('admin') || hasRole('coordinator');
      allow update: if hasRole('admin') || hasRole('coordinator') ||
                       (request.auth.uid == uid && onlyUpdatingOwnFields());
      allow delete: if hasRole('admin');
    }

    function onlyUpdatingOwnFields() {
      return !('roles' in request.resource.data.diff(resource.data).affectedKeys());
    }

    // GROUPS
    match /groups/{groupId} {
      allow read:  if isSignedIn();
      allow write: if hasRole('admin') || hasRole('coordinator');
    }

    // EVENTS
    // Trainer duerfen updaten wenn sie im trainers-Array ODER in einer Gruppe des Events sind.
    // Da Gruppen-Pruefung einen extra-Read erfordern wuerde (teuer), erlauben wir
    // allen teacher-Rolle das Updaten bestimmter Felder (trainer-safe fields).
    // Admin/Coordinator duerfen alles.
    match /events/{eventId} {
      allow read:   if isSignedIn();
      allow create: if hasRole('admin') || hasRole('coordinator');
      allow update: if hasRole('admin') || hasRole('coordinator') ||
                       (hasRole('teacher') && isTrainerOfEvent(eventId)) ||
                       (hasRole('teacher') && onlyTrainerSafeFields());
      allow delete: if hasRole('admin') || hasRole('coordinator');
    }

    function isTrainerOfEvent(eventId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/events/$(eventId)).data.trainers;
    }

    // Felder die ein Trainer ohne trainers-Array-Eintrag aendern darf
    function onlyTrainerSafeFields() {
      let allowed = ['status', 'cancellationReason', 'trainerLateNote',
                     'trainerBroadcast', 'trainers', 'updatedAt'];
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(allowed);
    }

    // ATTENDANCE
    match /eventAttendance/{docId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isPrivileged() ||
        request.auth.uid == resource.data.userId
      );
      allow delete: if isPrivileged();
    }

    // SETTINGS
    match /settings/{docId} {
      allow read:  if isSignedIn();
      allow write: if (docId == 'global' && (hasRole('admin') || hasRole('coordinator'))) ||
                      hasRole('admin');
    }
  }
}
